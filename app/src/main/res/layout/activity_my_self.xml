<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/haven_settings_back"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我眼中的自己"
            android:textColor="@color/haven_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnSaveBio"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="保存"
            android:textColor="@color/haven_accent_strong"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/haven_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="44dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这是你写下的自我描述和生活记录。住户不会每次都自动看到，只有使用查看指令时才会翻看。"
                android:textColor="@color/haven_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="2dp"
                android:paddingBottom="10dp" />

            <EditText
                android:id="@+id/inputMyBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:minLines="7"
                android:gravity="top|start"
                android:background="@drawable/input_bg"
                android:hint="写写你眼中的自己吧……\n\n这里仍然是原来的自由文本，你想写姓名、生日、身高、体重、爱好、习惯，或者任何别的东西都可以。"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/haven_text_primary"
                android:textColorHint="@color/haven_text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="动物伙伴"
                android:textColor="@color/haven_accent_strong"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnAddAnimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_item_bg"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="＋ 添加动物伙伴"
                android:textColor="@color/haven_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/animalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="植物伙伴"
                android:textColor="@color/haven_accent_strong"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnAddPlant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_item_bg"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="＋ 添加植物伙伴"
                android:textColor="@color/haven_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/plantContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
